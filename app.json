{
  "expo": {
    "name": "Mapill",
    "slug": "mapill-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mapillapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.gabsteffens.mapillapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#196FF3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gabsteffens.mapillapp",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#196FF3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Mapill acessa suas fotos apenas para você escolher a imagem da sua ficha, da caixa do remédio ou da receita. A foto fica no aparelho.",
          "cameraPermission": "O Mapill abre a câmera apenas quando você escolhe fotografar a caixa do remédio ou a receita. A foto fica no aparelho e não é enviada para lugar nenhum.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#196FF3"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Mapill usa a câmera para ler o código de barras da caixa do remédio e preencher o cadastro para você. Nenhuma foto é tirada ou guardada nesse processo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7064a16a-6bdb-4db3-aabc-7651a744e1de"
      }
    }
  }
}
